{
    "name": "el7cosmos/drupal-runtime",
    "description": "Drupal integration with Symfony Runtime",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "el7cosmos",
            "email": "el@elabee.me"
        }
    ],
    "funding": [
        {
            "type": "patreon",
            "url": "https://www.patreon.com/el7cosmos"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "drupal/core": "^10.3 || ^11.0",
        "symfony/runtime": "^6.4 || ^7.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "file-mapping": {
                "[web-root]/index.php": "assets/index.php",
                "[web-root]/update.php": "assets/update.php"
            }
        }
    }
}
